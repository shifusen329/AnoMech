<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Authors>Anomek</Authors>
    <Version>0.5.1.0</Version>
    <Description>Simulate ultimate raid mechanics solo client-side</Description>
    <RootNamespace>AnoMech</RootNamespace>
    <PackageProjectUrl>https://github.com/anomek/AnoMech</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AnoMech.Relay/AnoMech.Relay.csproj" />
    <InternalsVisibleTo Include="AnoMech.Tests" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
  </ItemGroup>
  <!-- The fork's scenarios not yet ported to the EnemyActions engine; each comes back as it is. -->
  <ItemGroup>
    <Compile Remove="Scenarios/Umad/P1GravenImage1/**" />
    <Compile Remove="Scenarios/Umad/P1GravenImage2/**" />
    <Compile Remove="Scenarios/Umad/P1Shared/UmadP1Kit.cs" />
    <Compile Remove="Scenarios/Umad/P1Shared/UmadP1SettingsRows.cs" />
    <Compile Remove="Scenarios/Umad/P2Trines/**" />
    <Compile Remove="Scenarios/Umad/P3BowelsOfAgony/**" />
  </ItemGroup>
</Project>
