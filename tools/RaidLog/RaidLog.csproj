<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>raidlog</AssemblyName>
    <RootNamespace>AnoMech.RaidLog</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="RaidReplay.Core\Encounters\Packs\*.json" LogicalName="RaidReplay.Core.Packs.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
